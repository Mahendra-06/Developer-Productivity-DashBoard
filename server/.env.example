# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security & Secrets
JWT_SECRET=your_jwt_secret_here

# Third-Party Integrations
GITHUB_TOKEN=your_github_personal_access_token_here

RESEND_API_KEY=
RESEND_FROM=chitrojumahendrakumar@gmail.com

# Developer Copilot AI Options:
# Option 1 (100% Free): Groq Cloud (Ultra-fast Llama 3.3 70B - Get free key at https://console.groq.com/keys)
GROQ_API_KEY=
# Or use:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option 2 (100% Free): Google Gemini API (Get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Or use:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=AIzaSy_your_gemini_key_here
# OPENAI_MODEL=gemini-1.5-flash

# Option 3: OpenAI (Paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Database Configuration (Task 3: MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/dmetrics
# Or for MongoDB Atlas cloud cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dmetrics?retryWrites=true&w=majority
