# DMetrics Environment Configuration Example
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security & Authentication
JWT_SECRET=your_jwt_secret_here

# ==============================================================================
# DEVELOPER COPILOT AI OPTIONS
# ==============================================================================
# Option 1 (100% Free): Groq Cloud (Free Llama-3.3-70B • https://console.groq.com/keys)
GROQ_API_KEY=
# Or:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option 2 (100% Free): Google Gemini (Free Gemini-1.5-Flash • https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Or:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=AIzaSy...
# OPENAI_MODEL=gemini-1.5-flash

# Option 3: OpenAI (Paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/dmetrics

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chitrojumahendrakumar@gmail.com
SMTP_PASSWORD=Google_APP_PASSWORD
SMTP_FROM=chitrojumahendrakumar@gmail.com